{
  "name": "ads-drive-lab",
  "version": "1.0.0",
  "description": "ADS DriveLab — 2D 算法 + 3D 渲染的自动驾驶模拟器（感知/规划/控制 + headless 批量测试与回放）",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "watch": "tsc --watch",
    "test": "tsc && node --test dist/js/test/**/*.test.js",
    "sim": "tsc && node dist/js/headless/run.js",
    "serve": "tsc && node dist/js/dev-server.js",
    "tiles": "tsc && node dist/js/mapgen/fetch-tiles.js",
    "mapgen": "tsc && node dist/js/mapgen/build-map.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/three": "^0.185.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "three": "^0.160.0"
  }
}
